# Publica o app como site (PWA) no GitHub Pages
name: Publicar PWA

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Instalar dependencias
        run: npm install
      - name: Copiar bibliotecas de PDF e Word
        run: |
          mkdir -p www/lib
          cp node_modules/html2pdf.js/dist/html2pdf.bundle.min.js www/lib/html2pdf.js
          cp node_modules/docx/dist/index.iife.js www/lib/docx.js
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: www
      - id: deployment
        uses: actions/deploy-pages@v4
