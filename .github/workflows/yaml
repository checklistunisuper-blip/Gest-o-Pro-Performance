
name: Publicar PWA

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Baixar repositorio
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Instalar dependencias
        run: npm install

      - name: Verificar bibliotecas
        run: |
          echo "Verificando HTML2PDF..."
          test -f node_modules/html2pdf.js/dist/html2pdf.bundle.min.js

          echo "Verificando DOCX..."
          test -f node_modules/docx/dist/index.iife.js

      - name: Copiar bibliotecas PDF e Word
        run: |
          mkdir -p www/lib

          cp node_modules/html2pdf.js/dist/html2pdf.bundle.min.js www/lib/html2pdf.js

          cp node_modules/docx/dist/index.iife.js www/lib/docx.js

          echo "Bibliotecas copiadas!"

      - name: Configurar GitHub Pages
        uses: actions/configure-pages@v5

      - name: Preparar site
        uses: actions/upload-pages-artifact@v3
        with:
          path: www

      - name: Publicar PWA
        id: deployment
        uses: actions/deploy-pages@v4
